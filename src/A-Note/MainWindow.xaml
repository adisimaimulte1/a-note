<Window
    x:Class="ANote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="#070706" Padding="22,0">
            <StackPanel x:Name="TitleBarDragTarget" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Width="112" Spacing="9">
                <Border Width="8" Height="8" Background="{StaticResource AccentBrush}" CornerRadius="1" />
                <TextBlock Text="A-NOTE" FontFamily="{StaticResource DisplayFontFamily}" FontSize="14" FontWeight="Bold" CharacterSpacing="180" />
            </StackPanel>
            <TextBlock x:Name="TitleContext" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="138,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Grid x:Name="TitleBarGestureTarget" Margin="104,0,92,0" Background="#01070706" Visibility="Collapsed" />
        </Grid>
        <ContentControl x:Name="MainContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
